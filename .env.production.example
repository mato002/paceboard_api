APP_NAME=PaceBoard
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://paceboard.zhengkyc.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paceboard_db
DB_USERNAME=paceboard
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=true

SANCTUM_TOKEN_EXPIRATION=10080
CORS_ALLOWED_ORIGINS=https://paceboard.zhengkyc.com

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@paceboard.com"
MAIL_FROM_NAME="${APP_NAME}"

QUEUE_CONNECTION=database

# PaceBoard
PACEBOARD_AUTO_MIGRATE=true
PACEBOARD_MAINTENANCE=false
SETUP_TOKEN=
DEPLOY_HOOK_ENABLED=false
DEPLOY_HOOK_TOKEN=

# Push notifications (requires queue worker)
FCM_ENABLED=false
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Weather on dashboard
WEATHER_ENABLED=false
OPENWEATHER_API_KEY=

# SMS
SMS_DRIVER=log
